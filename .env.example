# Kytkee kirjautumisen kokonaan pois päältä (kaikki data menee yhdelle testikäyttäjälle) -
# hyödyllinen demo/myyntivaiheessa ennen Google-tunnusten hankkimista. Poista rivi (tai
# aseta false) kun Google OAuth on valmis ja kirjautuminen otetaan tuotantokäyttöön.
NEXT_PUBLIC_SKIP_AUTH=true

# Neon Postgres
DATABASE_URL=

# Anthropic API (WOD-generaattori, kuvatulkinta, kehitysraportti)
ANTHROPIC_API_KEY=

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID,
# tyyppi "Web application". Redirect URI paikalliseen kehitykseen:
# http://localhost:3000/api/auth/callback/google
# ja tuotantoon: https://[vercel-domain]/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generoi komennolla: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
