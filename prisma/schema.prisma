// BoxLog - tietokantaskeema
// Vaihe 1: yksinkertainen malli, yksi User per tili, ei vielä salikohtaista jäsenyyttä.
// Vaihe 2 (kun useita saleja/urheilijoita): lisätään Gym-malli ja Membership-liitostaulu.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  // Stripe-tilaus (kuukausitilaus). subscriptionStatus: "active" | "canceled" | "past_due" | null
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?

  workouts Workout[]
  records  PersonalRecord[]
  usage    UsageEvent[]
}

model Workout {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      DateTime
  desc      String
  result    String?
  notes     String?
  focus     String?

  // Kellosta/sykevyöstä käsin syötetyt mittarit (vaihe 1: manuaalinen syöttö)
  restHr    Int?
  avgHr     Int?
  recovery  String?
  hrv       Int?
  sleepHrs  Float?
  rpe       Int?

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model PersonalRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  key       String   // esim. "takakyykky", "fran"
  label     String
  unit      String   // "kg" | "aika" | "kierrokset"
  value     String
  date      DateTime @default(now())

  @@index([userId, key])
}

// Yksi rivi per maksullinen AI-kutsu - käytetään kuukausirajoihin, jäähdytykseen ja globaaliin päiväkattoon.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String   // "wod" | "photo" | "report"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@index([createdAt])
}
